# Copy to .env for local development. `npm run db` writes a working .env for you on first run.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:54320/arka
NODE_ENV=development
APP_URL=http://localhost:5173
# Shows email codes on screen in development. Never in production (the server refuses to start).
OTP_DEV_ECHO=true
LOG_LEVEL=info

# Production only
# DATABASE_SSL=true            # TLS with certificate verification
# TRUST_PROXY=true             # behind Render / Cloudflare
# APP_SECRET=                  # optional; generated and stored in the database if absent
# MAIL_FROM=Arka <no-reply@your-domain>
# RESEND_API_KEY=              # HTTPS email (Render's free tier blocks SMTP)
# SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASS=   # fallback provider
# DEMO_DAYS=60                 # history simulated for demo workspaces (smaller = faster first boot)
